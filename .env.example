DB_USER=postgres
DB_PASS=changeme
DB_NAME=products_db
# Production uses IAM database authentication instead of DB_USER and DB_PASS.
# DB_IAM_AUTH=true
# DB_IAM_USER=soggy-backend@your-project.iam

# Use one of the following connection styles:
# 1) Cloud SQL Unix socket in Cloud Functions
INSTANCE_CONNECTION_NAME=your-project:your-region:your-instance
DB_SOCKET_PATH=/cloudsql

# 2) TCP host/port (local or private IP)
# DB_HOST=127.0.0.1
# DB_PORT=5432

PRICE_CURRENCY=USD
APP_BASE_URL=http://localhost:8080
GCP_PROJECT_ID=your-project-id
# Private bucket used for master and per-order personalized PDFs.
DIGITAL_ASSETS_BUCKET=soggy-digital-products
DIGITAL_ACCESS_DAYS=30
DIGITAL_DOWNLOAD_LIMIT=5
DIGITAL_SIGNED_URL_SECONDS=120
# Use a long random value. Only HMAC hashes of download IPs are retained.
DIGITAL_ACCESS_HASH_SALT=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Allowed destination countries for checkout. Comma-separated ISO country codes.
STRIPE_SHIPPING_ALLOWED_COUNTRIES=US
# Optional Stripe tax code applied to the generated shipping rate.
STRIPE_SHIPPING_TAX_CODE=txcd_92010001
UPS_CLIENT_ID=your-ups-client-id
UPS_CLIENT_SECRET=your-ups-client-secret
UPS_SHIPPER_NUMBER=your-ups-account-number
# JSON string, for example:
# {"name":"Soggy Stitches","address":{"line1":"6230 Carriage Ct","city":"Cumming","state":"GA","postalCode":"30040","country":"US"}}
SHIP_FROM_ADDRESS={"name":"Soggy Stitches","address":{"line1":"6230 Carriage Ct","city":"Cumming","state":"GA","postalCode":"30040","country":"US"}}
UPS_BASE_URL=https://onlinetools.ups.com
UPS_RATE_VERSION=v2409
UPS_PICKUP_TYPE=03
UPS_CUSTOMER_CLASSIFICATION=04
UPS_COMPRESSION_RATIO=0.8
UPS_PACKAGE_PADDING_INCHES=0.5
UPS_TIMEOUT_MS=6000
USPS_CONSUMER_KEY=your-usps-consumer-key
USPS_CONSUMER_SECRET=your-usps-consumer-secret
USPS_BASE_URL=https://apis.usps.com
USPS_SERVICE_STANDARDS_BASE_URL=https://apis.usps.com
USPS_TIMEOUT_MS=6000
# At least 32 random characters; signs short-lived carrier quotes used at checkout.
SHIPPING_QUOTE_SIGNING_SECRET=replace-with-a-strong-random-secret
SHIPPING_QUOTE_TTL_SECONDS=1800
SHIPPING_PROVIDER_DEADLINE_MS=7000
# Commission form + email delivery
COMMISSION_GCS_BUCKET=soggy-commission-requests
COMMISSION_FROM_EMAIL=soggystitches@gmail.com
COMMISSION_BUSINESS_EMAIL=soggystitches@gmail.com
COMMISSION_COMPANY_NAME=Soggy Stitches
# Optional public brand image used at the top of HTML emails
COMMISSION_EMAIL_HEADER_IMAGE_URL=https://storage.googleapis.com/soggy-public/emails/logo-fly.svg
# Gmail-friendly mode: if SMTP_SERVICE=gmail (or SMTP_USER is a gmail address and SMTP_HOST is blank),
# the app will use Nodemailer's Gmail transport settings automatically.
SMTP_SERVICE=gmail
# Optional for non-Gmail SMTP relays:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=soggystitches@gmail.com
SMTP_PASS=replace-with-your-app-password
# Optional, applied to all Checkout line items as product_data.tax_code
# Example for tangible goods: txcd_99999999
STRIPE_TAX_CODE=
DB_POOL_MAX=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=false
